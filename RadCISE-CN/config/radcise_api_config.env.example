# RadCISE API configuration example. Copy to your own environment file or export variables directly.
# Do NOT store real API keys in shared archives.
RADCISE_API_BASE_URL=https://your-llm-provider.example/v1/chat/completions
RADCISE_LLM_API_KEY=YOUR_API_KEY_HERE
RADCISE_MODEL=YOUR_MODEL_NAME
RADCISE_MAX_TOKENS=16392
RADCISE_TIMEOUT_SECONDS=180
RADCISE_MAX_RETRIES=5
RADCISE_WORKERS=10
RADCISE_JOINT_CANDIDATES=3
